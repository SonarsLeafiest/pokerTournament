# All traffic on one port — dashboard HTTP, agent WS, and spectator WS.
# Point your Cloudflare tunnel at this port.
PORT=3000

# Tournament won't start until this many agents are connected
MIN_PLAYERS=2

# Hard cap — extra agents connecting after this are ignored
MAX_PLAYERS=10

# Starting chip stack per agent
STARTING_STACK=1000

# Max players seated at a single table
TABLE_SIZE=10

# Milliseconds an agent has to respond before auto-fold
ACTION_TIMEOUT=5000

# Seconds to wait after MIN_PLAYERS connects before starting
# (gives the rest of the teams time to connect)
TOURNAMENT_START_DELAY=30
