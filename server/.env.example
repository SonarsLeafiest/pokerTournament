# All traffic on one port — dashboard HTTP, agent WS, admin panel, and spectator WS.
# Point your Cloudflare tunnel at this single port.
PORT=3000

# Tournament won't start until admin clicks Start in the admin panel.
# Minimum connected agents required before the Start button is enabled.
MIN_PLAYERS=2

# Starting chip stack per agent
STARTING_STACK=1000

# Max players seated at a single table.
# If more agents than TABLE_SIZE connect, they're split across multiple tables automatically.
TABLE_SIZE=6

# Milliseconds an agent has to respond before auto-fold
ACTION_TIMEOUT=5000

# Seconds of countdown after admin clicks Start (broadcasted to agents + dashboard)
TOURNAMENT_START_DELAY=10

# Admin panel password — set this before deploying.
# If unset, a random key is generated at startup and printed to the console.
# Admin URL: http://localhost:PORT/admin?key=YOUR_KEY
ADMIN_KEY=change-me

# Set to true to enable the Reset button in the admin panel (resets tournament without restarting the server)
DEVELOPER_MODE=false

# Milliseconds to pause before forwarding each action request to an agent.
# Gives spectators time to see the table state before the agent acts.
TURN_DELAY_MS=1500
